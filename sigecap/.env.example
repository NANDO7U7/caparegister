# Copy to .env (ignored by Git). Generate your own SECRET_KEY privately.
SIGECAP_ENV=local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# SECRET_KEY=
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/absolute/private/path/to/local.sqlite3

# Production: SIGECAP_ENV=production, DEBUG=False, explicit host names,
# SECRET_KEY generated privately and all PostgreSQL values supplied.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
DB_PORT=5432
